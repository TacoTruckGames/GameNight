# Only needed to deploy (`pnpm deploy`, `pnpm db:*:remote`). Local dev and tests need none of these.
# Wrangler reads the two Cloudflare values from the environment; scripts/deploy.mjs loads this file.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Optional; reserved for asset generation tooling. Not used by the app.
GEMINI_API_KEY=

# Google Maps Platform — optional. Without it the venue field is plain free text,
# which is a supported deployment (see README, "It degrades, always").
# Enable exactly two APIs on the key: Places API (New) and Maps Static API.
#
# This file is NOT read by the Worker — it is for the deploy scripts. The Worker
# gets its secrets from two other places, and the key has to be put in both:
#   local dev   .dev.vars  ->  GOOGLE_MAPS_API_KEY=...   (gitignored)
#   production  wrangler secret put GOOGLE_MAPS_API_KEY
# It is listed here anyway so one file still names every credential the project
# uses, and so `pnpm deploy` is not the only thing this file documents.
GOOGLE_MAPS_API_KEY=

# Optional; only if the Cloud project requires signed Maps Static URLs.
GOOGLE_MAPS_SIGNING_SECRET=
